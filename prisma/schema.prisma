generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Enrollment / inquiry leads submitted from the website
model Lead {
  id        String   @id @default(cuid())
  name      String
  phone     String
  email     String?
  course    String?
  message   String?
  status    String   @default("new") // new | contacted | enrolled | closed
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([status])
}

// Student accounts — created when someone enrolls. They log into the private
// Student Portal with phone + password (issued at enrollment time).
model Student {
  id           String       @id @default(cuid())
  name         String
  phone        String       @unique // canonical BD mobile: 01XXXXXXXXX
  passwordHash String       // sha256("<phone>:<password>")
  createdAt    DateTime     @default(now())

  enrollments Enrollment[]
  mockResults MockResult[]
}

// A paid course enrollment. The portal only shows content for courses the
// student actually enrolled in — no enrollment = empty portal.
model Enrollment {
  id         String   @id @default(cuid())
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseSlug String   // matches courses[].slug in site-data.ts
  batch      String   // e.g. "Batch 317"
  targetBand String?  // e.g. "7.5"
  examDate   String?  // ISO date — used for the exam countdown chip
  progress   Int      @default(0) // course completion 0-100
  attendance Int      @default(0) // attendance percentage 0-100
  status     String   @default("active") // active | paused | completed
  createdAt  DateTime @default(now())

  @@unique([studentId, courseSlug])
  @@index([studentId])
}

// Weekly mock test band scores shown in the portal "Mock Scores" section
model MockResult {
  id        String  @id @default(cuid())
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  label     String // e.g. "Mock Test 1"
  date      String // display date e.g. "15 Aug"
  listening Float
  reading   Float
  writing   Float
  speaking  Float
  overall   Float
  createdAt DateTime @default(now())

  @@index([studentId])
}

// Book Shop orders placed through the website checkout. Prices/totals are
// recomputed server-side from the site-data catalog (never trusted from the
// client). paymentMethod records the chosen channel — manual send-money
// (bKash/Nagad) and Cash on Delivery today; an online payment gateway can
// later flip paymentStatus to "paid" via webhook without schema changes.
model Order {
  id            String      @id @default(cuid())
  orderNo       String      @unique // "SIE-250604-8412" — shown to the buyer
  name          String
  phone         String // canonical BD mobile: 01XXXXXXXXX
  email         String?
  zone          String // pickup | sreemangal | inside-dhaka | outside-dhaka
  address       String? // required for courier zones
  note          String?
  subtotal      Int // BDT
  deliveryFee   Int // BDT
  total         Int // BDT
  paymentMethod String // bKash | Nagad | Cash on Delivery
  transactionId String? // manual send-money TrxID (optional at order time)
  paymentStatus String      @default("pending") // pending | verified | paid | failed
  status        String      @default("placed") // placed | confirmed | shipped | delivered | cancelled
  createdAt     DateTime    @default(now())
  items         OrderItem[]

  @@index([phone])
  @@index([createdAt])
  @@index([status])
}

// Public course-completion certificates. Holders (or employers) verify them
// from the website's "Verify Certificate" page (10MS /certificate pattern) by
// entering the human-readable certificate ID.
model Certificate {
  id       String @id // human ID, e.g. "SIE-CERT-2417"
  name     String
  course   String
  batch    String
  band     String // overall band score, e.g. "8.0"
  issued   String // display date, e.g. "30 May 2025"
  studentId String? // optional link to the portal Student account
  createdAt DateTime @default(now())

  @@index([name])
}

// Line items of an Order — unit price captured at purchase time.
model OrderItem {
  id        String @id @default(cuid())
  order     Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  kind      String // "book" (courses enroll via /api/portal/enroll instead)
  slug      String
  title     String
  price     Int // unit price BDT
  quantity  Int
  lineTotal Int

  @@index([orderId])
}
