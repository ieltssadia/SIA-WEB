generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Enrollment / inquiry leads submitted from the website
model Lead {
  id        String   @id @default(cuid())
  name      String
  phone     String
  email     String?
  course    String?
  message   String?
  status    String   @default("new") // new | contacted | enrolled | closed
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([status])
}

// Enrolled students — they log into the Student Portal (phone-based) to see
// the private class routine, class links and batch updates.
model Student {
  id         String   @id @default(cuid())
  name       String
  phone      String   @unique // canonical BD mobile: 01XXXXXXXXX
  courseSlug String // matches courses[].slug in site-data.ts
  batch      String // e.g. "Batch 317"
  status     String   @default("active") // active | paused | alumni
  createdAt  DateTime @default(now())
}
