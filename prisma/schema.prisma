generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Enrollment / inquiry leads submitted from the website
model Lead {
  id        String   @id @default(cuid())
  name      String
  phone     String
  email     String?
  course    String?
  message   String?
  status    String   @default("new") // new | contacted | enrolled | closed
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([status])
}

// Student accounts — created when someone enrolls. They log into the private
// Student Portal with phone + password (issued at enrollment time).
model Student {
  id           String       @id @default(cuid())
  name         String
  phone        String       @unique // canonical BD mobile: 01XXXXXXXXX
  passwordHash String       // sha256("<phone>:<password>")
  createdAt    DateTime     @default(now())

  enrollments Enrollment[]
  mockResults MockResult[]
}

// A paid course enrollment. The portal only shows content for courses the
// student actually enrolled in — no enrollment = empty portal.
model Enrollment {
  id         String   @id @default(cuid())
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseSlug String   // matches courses[].slug in site-data.ts
  batch      String   // e.g. "Batch 317"
  targetBand String?  // e.g. "7.5"
  examDate   String?  // ISO date — used for the exam countdown chip
  progress   Int      @default(0) // course completion 0-100
  attendance Int      @default(0) // attendance percentage 0-100
  status     String   @default("active") // active | paused | completed
  createdAt  DateTime @default(now())

  @@unique([studentId, courseSlug])
  @@index([studentId])
}

// Weekly mock test band scores shown in the portal "Mock Scores" section
model MockResult {
  id        String  @id @default(cuid())
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  label     String // e.g. "Mock Test 1"
  date      String // display date e.g. "15 Aug"
  listening Float
  reading   Float
  writing   Float
  speaking  Float
  overall   Float
  createdAt DateTime @default(now())

  @@index([studentId])
}

// Book Shop orders placed through the website checkout. Prices/totals are
// recomputed server-side from the site-data catalog (never trusted from the
// client). paymentMethod records the chosen channel — manual send-money
// (bKash/Nagad) and Cash on Delivery today; an online payment gateway can
// later flip paymentStatus to "paid" via webhook without schema changes.
model Order {
  id            String      @id @default(cuid())
  orderNo       String      @unique // "SIE-250604-8412" — shown to the buyer
  name          String
  phone         String // canonical BD mobile: 01XXXXXXXXX
  email         String?
  zone          String // pickup | sreemangal | inside-dhaka | outside-dhaka
  address       String? // required for courier zones
  note          String?
  subtotal      Int // BDT
  deliveryFee   Int // BDT
  total         Int // BDT
  paymentMethod String // bKash | Nagad | Cash on Delivery
  transactionId String? // manual send-money TrxID (optional at order time)
  paymentStatus String      @default("pending") // pending | verified | paid | failed
  status        String      @default("placed") // placed | confirmed | shipped | delivered | cancelled
  createdAt     DateTime    @default(now())
  items         OrderItem[]

  @@index([phone])
  @@index([createdAt])
  @@index([status])
}

// Public course-completion certificates. Holders (or employers) verify them
// from the website's "Verify Certificate" page (10MS /certificate pattern) by
// entering the human-readable certificate ID.
model Certificate {
  id       String @id // human ID, e.g. "SIE-CERT-2417"
  name     String
  course   String
  batch    String
  band     String // overall band score, e.g. "8.0"
  issued   String // display date, e.g. "30 May 2025"
  studentId String? // optional link to the portal Student account
  fileUrl  String? // admin-uploaded certificate file (PDF/image) — portal download
  createdAt DateTime @default(now())

  @@index([name])
}

// A scheduled live class. Students join the real-time classroom
// (#/live/<slug>) — chat, synced slides, polls, raise-hand and the teacher
// camera stream all run over the socket.io live-class-service
// (mini-services/live-class-service, port 3003). `slides` is JSON because
// Prisma does not support Json columns on SQLite.
model LiveClass {
  id          String   @id @default(cuid())
  slug        String   @unique // e.g. "speaking-marathon"
  title       String
  courseSlug  String? // optional link to courses[].slug in site-data.ts
  teacher     String   @default("Sadia Ma'am")
  description String?
  startsAt    DateTime
  durationMin Int      @default(60)
  status      String   @default("scheduled") // scheduled | live | ended
  slides      String   @default("[]") // JSON: [{ title, bullets[], note? }]
  createdAt   DateTime @default(now())

  @@index([status])
  @@index([startsAt])
}

// Line items of an Order — unit price captured at purchase time.
model OrderItem {
  id        String @id @default(cuid())
  order     Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  kind      String // "book" (courses enroll via /api/portal/enroll instead)
  slug      String
  title     String
  price     Int // unit price BDT
  quantity  Int
  lineTotal Int

  @@index([orderId])
}

// Team members who run the admin CMS. Roles gate every admin API + section:
//   owner  → everything, including Team management
//   admin  → everything except Team management
//   teacher→ live classes, students (view), certificates (issue), notices
model AdminUser {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique // canonical lowercase
  passwordHash String // sha256("<email>:<password>")
  role         String   @default("teacher") // owner | admin | teacher
  status       String   @default("active") // active | disabled
  createdAt    DateTime @default(now())
}

// Managed course catalog — seeded from site-data defaults, then editable from
// the admin CMS (price, seats, syllabus, publish/delist). Public pages read
// /api/catalog which serves DB rows with site-data as the fallback.
model Course {
  id           String   @id @default(cuid())
  slug         String   @unique
  title        String
  titleBn      String   @default("")
  desc         String   @default("")
  lessons      Int      @default(10)
  duration     String   @default("")
  price        Int? // null → "call for price"
  oldPrice     Int?
  tag          String   @default("")
  icon         String   @default("book")
  features     String   @default("[]") // JSON string[]
  category     String   @default("complete") // complete | beginner | exam
  rating       Float    @default(4.8)
  students     Int      @default(0)
  nextBatch    String   @default("")
  mode         String   @default("Online")
  scheduleNote String   @default("")
  seatsLeft    Int?
  seatsTotal   Int?
  accessPeriod String?
  syllabus     String   @default("[]") // JSON string[]
  published    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Book Shop catalog — admin can add/edit price, delist (hide from shop) etc.
// Order pricing reads this table first (site-data stays the fallback).
model Book {
  id         String   @id @default(cuid())
  slug       String   @unique
  title      String
  titleBn    String   @default("")
  author     String   @default("Sadia Rahman")
  desc       String   @default("")
  price      Int // BDT
  oldPrice   Int?
  category   String   @default("reading")
  cover      String   @default("/images/books/reading-tricks.png")
  tag        String?
  pages      Int      @default(0)
  highlights String   @default("[]") // JSON string[]
  listed     Boolean  @default(true) // false → hidden from the shop grid
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// Student-portal downloadable resources (files live in /public/downloads/).
model DownloadResource {
  id        String   @id @default(cuid())
  title     String
  desc      String   @default("")
  category  String   @default("writing") // writing | speaking | vocabulary | mock-tools
  type      String   @default("PDF")
  size      String   @default("")
  href      String // e.g. /downloads/writing-task-2-structures.pdf
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Student-portal notice board entries. `date` is a display string ("10 Sep").
model Notice {
  id        String   @id @default(cuid())
  date      String // display date, e.g. "10 Sep"
  tag       String   @default("Notice") // Class Update | Mock Test | Speaking Club | Notice
  title     String
  body      String
  createdAt DateTime @default(now())
}

// ── Cambridge IELTS Library ─────────────────────────────────────────────
// The full official Cambridge practice-test catalog (engnovate-style):
// books 1-19 in Academic and General Training editions, four tests each,
// every test carrying per-skill content. SQLite has no Json columns, so
// each skill's interactive payload (questions, passages, transcripts,
// band-9 samples...) is stored as a JSON string.
model CambridgeBook {
  id     String          @id @default(cuid())
  number Int // 1..19 — the book number on the cover
  module String // "academic" | "general"
  title  String // e.g. "Cambridge IELTS 19 Academic"
  year   Int // approximate publication year
  accent String // cover accent hex for the generated spine art
  blurb  String
  tests  CambridgeTest[]

  @@unique([number, module])
  @@index([module])
}

// One practice test inside a book. Skills are separate JSON payloads so the
// player can fetch only the skill being attempted.
model CambridgeTest {
  id        String        @id @default(cuid())
  bookId    String
  book      CambridgeBook @relation(fields: [bookId], references: [id], onDelete: Cascade)
  number    Int // 1..4
  listening String        @default("{}") // { durationMin, parts: [{ n, title, audio, transcript, questions[] }] }
  reading   String        @default("{}") // { durationMin, passages: [{ n, title, text, questions[] }] }
  writing   String        @default("{}") // { task1, task2 } — prompts + band-9 samples + examiner notes
  speaking  String        @default("{}") // { part1, part2, part3, sample } — cue cards + sample answers + audio

  @@unique([bookId, number])
  @@index([bookId])
}

// ── WordPress-style no-code content (Task 21) ────────────────────────────

// Free IELTS tips shown on the #/tips page — fully admin-editable.
model Tip {
  id        String   @id @default(cuid())
  title     String
  excerpt   String   @default("")
  category  String   @default("IELTS Reading")
  icon      String   @default("lightbulb")
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Public team members rendered on #/team, #/team/<slug> and the home marquee.
// (NOT admin accounts — those live in AdminUser.) JSON columns hold the
// profile arrays because SQLite has no Json type.
model SiteTeamMember {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  role        String   @default("")
  tagline     String   @default("")
  photo       String   @default("")
  chip        String   @default("bg-pastel-sky text-[#2c4f8a]")
  bio         String   @default("[]") // JSON string[]
  specialties String   @default("[]") // JSON string[]
  credentials String   @default("[]") // JSON string[]
  stats       String   @default("[]") // JSON [{ value, label }]
  quote       String   @default("")
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Weekly class routine rows (#/routine, home RoutineBanner, portal planner).
// start/end are display strings ("10:00 AM") exactly like the static data.
model RoutineSlot {
  id         String   @id @default(cuid())
  day        String // Sunday..Saturday
  start      String   @default("")
  end        String   @default("")
  courseSlug String   @default("")
  batch      String   @default("")
  topic      String   @default("")
  mode       String   @default("Hybrid")
  type       String   @default("Regular Class")
  published  Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// Admin-uploaded suggestion/practice material (interactive HTML tests, PDFs,
// audio...) — served through the portal "Suggestions" section to students
// enrolled in at least one PAID course. Uploading a file auto-creates the row
// (or is attached from the pick-list), so publishing is a one-step action.
model Suggestion {
  id        String   @id @default(cuid())
  title     String
  desc      String   @default("")
  category  String   @default("Practice")
  fileUrl   String // e.g. /uploads/suggestions/listening-test-28.html
  kind      String   @default("html") // html | pdf | audio | video | link
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
