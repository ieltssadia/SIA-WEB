generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Enrollment / inquiry leads submitted from the website
model Lead {
  id        String   @id @default(cuid())
  name      String
  phone     String
  email     String?
  course    String?
  message   String?
  status    String   @default("new") // new | contacted | enrolled | closed
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([status])
}

// Enrolled students — they log into the Student Portal (phone + OTP) to see
// the private class routine, class links and batch updates.
model Student {
  id         String   @id @default(cuid())
  name       String
  phone      String   @unique // canonical BD mobile: 01XXXXXXXXX
  courseSlug String // matches courses[].slug in site-data.ts
  batch      String // e.g. "Batch 317"
  targetBand String? // e.g. "7.5"
  examDate   String? // ISO date — used for the exam countdown chip
  progress   Int      @default(0) // course completion 0-100
  attendance Int      @default(0) // attendance percentage 0-100
  status     String   @default("active") // active | paused | alumni
  createdAt  DateTime @default(now())

  mockResults MockResult[]

  @@index([courseSlug])
}

// Weekly mock test band scores shown in the portal "Mock Scores" section
model MockResult {
  id        String  @id @default(cuid())
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  label     String // e.g. "Mock Test 1"
  date      String // display date e.g. "15 Aug"
  listening Float
  reading   Float
  writing   Float
  speaking  Float
  overall   Float
  createdAt DateTime @default(now())

  @@index([studentId])
}
